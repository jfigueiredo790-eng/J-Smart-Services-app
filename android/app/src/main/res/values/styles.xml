<resources>
    <!-- Base application theme. -->
    <style name="Theme.JSmartServices" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/bg_darker</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="Theme.JSmartServices.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
