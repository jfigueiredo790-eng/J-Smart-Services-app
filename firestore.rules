rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives & Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'jfigueiredo790@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidRequestStatus(status) {
      return status in ['pendente', 'novamente_disponivel', 'aceito', 'em_negociacao', 'em_progresso', 'concluido', 'cancelado'];
    }

    function hasNoSecrets(data) {
      return !('password' in data) && !('adminPin' in data) && !('otpCode' in data);
    }

    function isValidUserCreate(data, userId) {
      return hasNoSecrets(data) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('role' in data) || data.role in ['cliente', 'profissional']) &&
        (!('walletBalanceKz' in data) || data.walletBalanceKz == 0) &&
        (!('blocked' in data) || data.blocked == false) &&
        (!('isDeleted' in data) || data.isDeleted == false) &&
        (!('adminSubRole' in data)) &&
        (!('subscriptionPlan' in data) || data.subscriptionPlan == 'free_trial') &&
        (!('planExpiresAt' in data)) &&
        (!('planStartedAt' in data)) &&
        (!('trialDurationDays' in data) || data.trialDurationDays in [0, 30]) &&
        (!('trialStartServerTimestamp' in data) || data.trialStartServerTimestamp == request.time) &&
        (!('id' in data) || data.id == userId);
    }

    function isValidUserUpdate(data, prev) {
      return hasNoSecrets(data) &&
        (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 120)) &&
        (!('role' in data) || data.role == prev.role || (prev.accountType == 'duplo' && data.role in ['cliente', 'profissional'])) &&
        (!('accountType' in data) || data.accountType == prev.accountType) &&
        (!('adminSubRole' in data) || ('adminSubRole' in prev && data.adminSubRole == prev.adminSubRole)) &&
        (!('walletBalanceKz' in data) || ('walletBalanceKz' in prev && data.walletBalanceKz == prev.walletBalanceKz)) &&
        (!('blocked' in data) || ('blocked' in prev && data.blocked == prev.blocked)) &&
        (!('accountStatus' in data) || ('accountStatus' in prev && data.accountStatus == prev.accountStatus)) &&
        (!('isDeleted' in data) || ('isDeleted' in prev && data.isDeleted == prev.isDeleted)) &&
        (!('subscriptionPlan' in data) || ('subscriptionPlan' in prev && data.subscriptionPlan == prev.subscriptionPlan)) &&
        (!('planStartedAt' in data) || ('planStartedAt' in prev && data.planStartedAt == prev.planStartedAt)) &&
        (!('planExpiresAt' in data) || ('planExpiresAt' in prev && data.planExpiresAt == prev.planExpiresAt)) &&
        (!('trialStartDate' in data) || ('trialStartDate' in prev && data.trialStartDate == prev.trialStartDate)) &&
        (!('trialEndsAt' in data) || ('trialEndsAt' in prev && data.trialEndsAt == prev.trialEndsAt)) &&
        (!('trialDurationDays' in data) || ('trialDurationDays' in prev && data.trialDurationDays == prev.trialDurationDays)) &&
        (!('trialStartServerTimestamp' in data) || ('trialStartServerTimestamp' in prev && data.trialStartServerTimestamp == prev.trialStartServerTimestamp)) &&
        (!('subscriptionStatus' in data) || ('subscriptionStatus' in prev && data.subscriptionStatus == prev.subscriptionStatus)) &&
        (!('experienceVerified' in data) || ('experienceVerified' in prev && data.experienceVerified == prev.experienceVerified));
    }

    function isValidPublicPro(data) {
      return !('email' in data) &&
        !('phone' in data) &&
        !('documentNumber' in data) &&
        !('walletBalanceKz' in data) &&
        !('password' in data) &&
        !('adminPin' in data) &&
        !('proofUrl' in data) &&
        !('proofFileName' in data) &&
        !('proofFileType' in data) &&
        !('proofNote' in data) &&
        !('paymentMethod' in data) &&
        !('iban' in data) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('categories' in data) || (data.categories is list && data.categories.size() <= 50));
    }

    function isValidPublicProCreate(data) {
      return isValidPublicPro(data) &&
        (!('subscriptionPlan' in data) || data.subscriptionPlan == 'free_trial') &&
        !('planExpiresAt' in data) &&
        !('planStartedAt' in data) &&
        (!('trialDurationDays' in data) || data.trialDurationDays in [0, 30]) &&
        (!('blocked' in data) || data.blocked == false) &&
        (!('isDeleted' in data) || data.isDeleted == false);
    }

    function isValidPublicProUpdate(data, prev) {
      return isValidPublicPro(data) &&
        (!('subscriptionPlan' in data) || ('subscriptionPlan' in prev && data.subscriptionPlan == prev.subscriptionPlan)) &&
        (!('planStartedAt' in data) || ('planStartedAt' in prev && data.planStartedAt == prev.planStartedAt)) &&
        (!('planExpiresAt' in data) || ('planExpiresAt' in prev && data.planExpiresAt == prev.planExpiresAt)) &&
        (!('trialStartDate' in data) || ('trialStartDate' in prev && data.trialStartDate == prev.trialStartDate)) &&
        (!('trialEndsAt' in data) || ('trialEndsAt' in prev && data.trialEndsAt == prev.trialEndsAt)) &&
        (!('trialDurationDays' in data) || ('trialDurationDays' in prev && data.trialDurationDays == prev.trialDurationDays)) &&
        (!('subscriptionStatus' in data) || ('subscriptionStatus' in prev && data.subscriptionStatus == prev.subscriptionStatus)) &&
        (!('blocked' in data) || ('blocked' in prev && data.blocked == prev.blocked)) &&
        (!('isDeleted' in data) || ('isDeleted' in prev && data.isDeleted == prev.isDeleted)) &&
        (!('experienceVerified' in data) || ('experienceVerified' in prev && data.experienceVerified == prev.experienceVerified));
    }

    function isValidServiceRequest(data) {
      return hasNoSecrets(data) &&
        !('clientPhone' in data) &&
        data.keys().hasAll(['title', 'categoryId', 'province', 'clientId']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.categoryId is string && data.categoryId.size() <= 128 &&
        data.province is string && data.province.size() <= 100 &&
        data.clientId is string && data.clientId.size() <= 128 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        (!('status' in data) || isValidRequestStatus(data.status));
    }

    function isValidChatMessage(data) {
      return hasNoSecrets(data) &&
        data.text is string && data.text.size() <= 2000 &&
        data.senderId is string && data.senderId.size() <= 128 &&
        'participants' in data && data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 10;
    }

    function isValidPaidPlanAndPrice(data) {
      return data.planId in ['plan_14d', 'plan_30d', 'plan_90d'] && (
        (data.planId == 'plan_14d' && data.amountKz == 1500) ||
        (data.planId == 'plan_30d' && data.amountKz == 3000) ||
        (data.planId == 'plan_90d' && data.amountKz == 8000)
      );
    }

    function isValidWalletTxCreate(data) {
      return hasNoSecrets(data) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.amountKz is number && data.amountKz > 0 && data.amountKz <= 100000000 &&
        data.status == 'pendente' &&
        data.type in ['deposit', 'payment', 'withdrawal'] &&
        (!('reviewedBy' in data)) &&
        (!('reviewedAt' in data)) &&
        (!('subscriptionStartedAt' in data)) &&
        (!('subscriptionExpiresAt' in data)) &&
        (data.type != 'payment' || !('planId' in data) || isValidPaidPlanAndPrice(data)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500));
    }

    function isValidWorkPost(data) {
      return hasNoSecrets(data) &&
        data.professionalId is string && data.professionalId.size() <= 128 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
        (!('likedBy' in data) || (data.likedBy is list && data.likedBy.size() <= 5000));
    }

    // --- USER PROFILES (Private PII) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if isValidId(userId) && (isAdmin() || (isOwner(userId) && isValidUserCreate(incoming(), userId)));
      allow update: if isValidId(userId) && (isAdmin() || (isOwner(userId) && isValidUserUpdate(incoming(), existing())));
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- PROFESSIONALS PRIVATE PROFILES (Private PII & Wallet) ---
    match /professionals/{proId} {
      allow get: if isValidId(proId) && (isOwner(proId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if isValidId(proId) && (isAdmin() || (isOwner(proId) && isValidUserCreate(incoming(), proId)));
      allow update: if isValidId(proId) && (isAdmin() || (isOwner(proId) && isValidUserUpdate(incoming(), existing())));
      allow delete: if isValidId(proId) && isAdmin();
    }

    // --- PUBLIC PROFESSIONALS DIRECTORY (PII-Free & Proof-Free Search Catalog) ---
    match /professionals_public/{proId} {
      allow get: if isValidId(proId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(proId) && (isAdmin() || (isOwner(proId) && isValidPublicProCreate(incoming())));
      allow update: if isValidId(proId) && (isAdmin() || (isOwner(proId) && isValidPublicProUpdate(incoming(), existing())));
      allow delete: if isValidId(proId) && isAdmin();
    }

    // --- ANTI-DUPLICATE FREE TRIAL CLAIMS (One initial 30-day free trial per identity) ---
    match /trial_claims/{claimId} {
      allow get: if isValidId(claimId) && isSignedIn();
      allow list: if isAdmin();
      allow create: if isValidId(claimId) && isSignedIn() &&
        incoming().claimedBy == request.auth.uid &&
        (!('trialDurationDays' in incoming()) || incoming().trialDurationDays == 30);
      allow update, delete: if isValidId(claimId) && isAdmin();
    }

    // --- ADMINISTRATORS & IMMUTABLE AUDIT LOGS ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    match /administradores/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && incoming().adminId is string && incoming().action is string && incoming().action.size() <= 200;
      allow update, delete: if false;
    }

    // --- SERVICE REQUESTS (Exclusivity & Participant Privacy) ---
    match /service_requests/{requestId} {
      allow get: if isValidId(requestId) && (
        isAdmin() ||
        (isSignedIn() && (
          existing().clientId == request.auth.uid ||
          existing().professionalId == request.auth.uid ||
          existing().status in ['pendente', 'novamente_disponivel']
        ))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.clientId == request.auth.uid ||
          resource.data.professionalId == request.auth.uid ||
          resource.data.status in ['pendente', 'novamente_disponivel']
        )
      );
      allow create: if isValidId(requestId) && isSignedIn() && isValidServiceRequest(incoming()) &&
        incoming().clientId == request.auth.uid &&
        (!('status' in incoming()) || incoming().status in ['pendente', 'aceito']);

      allow update: if isValidId(requestId) && isSignedIn() && isValidServiceRequest(incoming()) && (
        isAdmin() ||
        (
          !(existing().status in ['concluido', 'cancelado']) &&
          incoming().clientId == existing().clientId &&
          (
            // Case A: First-come-first-served exclusive accept
            (
              existing().status in ['pendente', 'novamente_disponivel'] &&
              incoming().status == 'aceito' &&
              incoming().professionalId == request.auth.uid &&
              existing().clientId != request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isReopened', 'acceptedAt', 'professionalId', 'professionalName', 'professionalAvatar', 'commissionAmountKz', 'netProAmountKz', 'updatedAt'])
            ) ||
            // Case B: Release without agreement back to available
            (
              incoming().status == 'novamente_disponivel' &&
              (existing().clientId == request.auth.uid || existing().professionalId == request.auth.uid) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isReopened', 'reopenedAt', 'previousProId', 'previousProName', 'cancellationReason', 'professionalId', 'professionalName', 'professionalAvatar', 'updatedAt'])
            ) ||
            // Case C: Client or assigned Pro updating active request status/budget/review flag
            (
              (existing().clientId == request.auth.uid || existing().professionalId == request.auth.uid) &&
              incoming().professionalId == existing().professionalId &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'budgetKz', 'completedAt', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'hasReview', 'updatedAt'])
            )
          )
        )
      );

      allow delete: if isValidId(requestId) && (isAdmin() || (isSignedIn() && existing().clientId == request.auth.uid && existing().status == 'pendente'));
    }

    // --- CHAT MESSAGES & CONVERSATIONS (Strictly Private Participants) ---
    match /chat_messages/{messageId} {
      allow get: if isValidId(messageId) && (
        isAdmin() ||
        (isSignedIn() && (
          existing().senderId == request.auth.uid ||
          existing().receiverId == request.auth.uid ||
          ('participants' in existing() && request.auth.uid in existing().participants)
        ))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          ('participants' in resource.data && request.auth.uid in resource.data.participants)
        )
      );
      allow create: if isValidId(messageId) && isSignedIn() && isValidChatMessage(incoming()) &&
        incoming().senderId == request.auth.uid &&
        request.auth.uid in incoming().participants;

      allow update: if isValidId(messageId) && isSignedIn() && (
        isAdmin() ||
        (
          (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || ('participants' in existing() && request.auth.uid in existing().participants)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readBy', 'status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(messageId) && isAdmin();
    }

    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (isAdmin() || (isSignedIn() && 'participants' in existing() && request.auth.uid in existing().participants));
      allow list: if isAdmin() || (isSignedIn() && 'participants' in resource.data && request.auth.uid in resource.data.participants);
      allow create: if isValidId(conversationId) && (isAdmin() || (isSignedIn() && 'participants' in incoming() && incoming().participants is list && incoming().participants.size() <= 10 && request.auth.uid in incoming().participants));
      allow update: if isValidId(conversationId) && (isAdmin() || (isSignedIn() && 'participants' in existing() && request.auth.uid in existing().participants));
      allow delete: if isValidId(conversationId) && isAdmin();
    }

    // --- REVIEWS & RATINGS ---
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(reviewId) && isSignedIn() &&
        incoming().clientId == request.auth.uid &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
        (!('comment' in incoming()) || (incoming().comment is string && incoming().comment.size() <= 1000));
      allow update, delete: if isValidId(reviewId) && isAdmin();
    }

    // --- WALLET TRANSACTIONS & SUBSCRIPTION PAYMENT PROOFS (Strictly Private: Owner + Admin Only) ---
    match /wallet_transactions/{txId} {
      allow get: if isValidId(txId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(txId) && (isAdmin() || (isSignedIn() && isValidWalletTxCreate(incoming())));
      allow update, delete: if isValidId(txId) && isAdmin();
    }

    // --- RECOVERY OTPs (Server-Only / Blocked from Client SDK) ---
    match /recovery_otps/{sessionId} {
      allow read, write: if false;
    }

    // --- WORK POSTS & FEED ---
    match /posts/{postId} {
      allow get: if isValidId(postId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(postId) && (isAdmin() || (isSignedIn() && isValidWorkPost(incoming()) && incoming().professionalId == request.auth.uid));
      allow update: if isValidId(postId) && isSignedIn() && isValidWorkPost(incoming()) && (
        isAdmin() ||
        (existing().professionalId == request.auth.uid && incoming().professionalId == existing().professionalId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'likedBy', 'reactions'])
      );
      allow delete: if isValidId(postId) && (isAdmin() || (isSignedIn() && existing().professionalId == request.auth.uid));
    }

    match /work_feed_posts/{postId} {
      allow get: if isValidId(postId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(postId) && (isAdmin() || (isSignedIn() && isValidWorkPost(incoming()) && incoming().professionalId == request.auth.uid));
      allow update: if isValidId(postId) && isSignedIn() && isValidWorkPost(incoming()) && (
        isAdmin() ||
        (existing().professionalId == request.auth.uid && incoming().professionalId == existing().professionalId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'likedBy', 'reactions'])
      );
      allow delete: if isValidId(postId) && (isAdmin() || (isSignedIn() && existing().professionalId == request.auth.uid));
    }

    // --- NOTIFICATIONS ---
    match /app_notifications/{notifId} {
      allow get: if isValidId(notifId) && (isAdmin() || (isSignedIn() && (existing().userId == request.auth.uid || existing().userId in ['all', 'pro_all', 'client_all'])));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId in ['all', 'pro_all', 'client_all']));
      allow create: if isValidId(notifId) && (isAdmin() || (isSignedIn() && incoming().type != 'comunicado_jsmart' && incoming().title is string && incoming().title.size() <= 200 && incoming().message is string && incoming().message.size() <= 1000));
      allow update: if isValidId(notifId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])));
      allow delete: if isValidId(notifId) && isAdmin();
    }

    // --- CATEGORIES & SERVICES ---
    match /categories/{catId} {
      allow get: if isValidId(catId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isValidId(catId) && isAdmin();
    }

    match /servicos/{serviceId} {
      allow get: if isValidId(serviceId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isValidId(serviceId) && isAdmin();
    }

    // --- REPORTS & SUPPORT TICKETS ---
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && (isAdmin() || (isSignedIn() && existing().reporterId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isValidId(reportId) && isSignedIn() && incoming().reporterId == request.auth.uid && incoming().status == 'pendente';
      allow update, delete: if isValidId(reportId) && isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isSignedIn() && existing().reporterId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isValidId(ticketId) && isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update, delete: if isValidId(ticketId) && isAdmin();
    }

    // --- LEGACY BLUEPRINT COLLECTIONS (Hardened to Owner/Admin Only) ---
    match /clientes/{clientId} {
      allow get: if isValidId(clientId) && (isOwner(clientId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(clientId) && (isAdmin() || (isOwner(clientId) && hasNoSecrets(incoming())));
      allow update, delete: if isValidId(clientId) && isAdmin();
    }

    match /profissionais/{proId} {
      allow get: if isValidId(proId) && (isOwner(proId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(proId) && isAdmin();
    }

    match /pedidos/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isSignedIn() && existing().clientId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isValidId(requestId) && isAdmin();
    }

    match /pagamentos/{paymentId} {
      allow get: if isValidId(paymentId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isValidId(paymentId) && isAdmin();
    }

    match /avaliacoes/{reviewId} {
      allow get: if isValidId(reviewId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isValidId(reviewId) && isAdmin();
    }

    match /mensagens/{messageId} {
      allow get: if isValidId(messageId) && (isAdmin() || (isSignedIn() && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid));
      allow create, update, delete: if isValidId(messageId) && isAdmin();
    }

    // --- PLATFORM SETTINGS (No Admin PIN/Secrets Permitted) ---
    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(settingId) && isAdmin() && hasNoSecrets(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // --- CONNECTION CHECK ---
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
